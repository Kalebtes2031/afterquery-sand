 const api=(p,o)=>fetch('http://localhost:5000'+p,o).then(async r=>{const d=await r.json();if(!r.ok)throw Object.assign(new Error(d.error||'Request failed'),{status:r.status});return d});
 function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
 async function load(){const q=new URLSearchParams();if(state.filter!=='all')q.set('status',state.filter);if(state.region!=='all')q.set('region',state.region);if(state.q)q.set('q',state.q);[state.shipments,state.summary]=await Promise.all([api('/api/shipments?'+q),api('/api/summary')]).then(([a,b])=>[a.shipments,b]);if(!state.selected||!state.shipments.some(x=>x.id===state.selected))state.selected=state.shipments[0]?.id||null;render();}
